# Virtualenv
.venv/
__pycache__/
*.pyc

# Raw dataset - 516 MB, fetched by scripts/fetch_data.sh, never committed
data/twcs.csv

# Large derived artefacts - regenerated deterministically from twcs.csv
data/amazon_openers.tsv
data/amazon_clusters.tsv

# Local secrets
.env

# Build artefacts - regenerated by build_pairs.py / retrieve.py
data/amazon_pairs.jsonl
data/retrieval_index.pkl

# LLM caches - regenerated by evaluate.py, keyed by message id. Not committed
# until they come from the real golden set and a proper judge model.
data/predictions_llm.jsonl
data/replies_*.jsonl
data/judge_*.jsonl
!data/judge_human.jsonl

# results/ is committed only once golden_r1.jsonl exists and evaluate.py has
# been run against it; nothing derived from a synthetic set belongs there.
